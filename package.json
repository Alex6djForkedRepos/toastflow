{
  "name": "toastflow",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "site:dev": "pnpm --filter toastflow-site dev",
    "site:build": "pnpm --filter toastflow-site build",
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "packageManager": "pnpm@9.12.3",
  "devDependencies": {
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "~10.10.0",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.69.0"
  }
}
